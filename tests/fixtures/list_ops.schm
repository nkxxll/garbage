;; Length of a list
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(display (length (list 1 2 3 4 5)))
(newline)
(display (length (list)))
(newline)

;; Append two lists
(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))

(display (append (list 1 2 3) (list 4 5 6)))
(newline)
(display (append (list) (list 7 8)))
(newline)
